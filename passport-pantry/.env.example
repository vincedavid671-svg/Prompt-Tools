# Passport Pantry — environment variables
#
# Copy to .env and fill in locally. Never commit a filled-in .env.
# Variable NAMES only in this file; no values, no examples of real keys.
#
# NOTE: the application itself (prototype.html) reads NO environment
# variables. It is a single static file with no build step and no server.
# Everything below is consumed only by the build-time scripts in tools/.

# --- tools/fdc-resolve.mjs -------------------------------------------------
# USDA FoodData Central API key. Free, no cost, no card.
# Sign up: https://fdc.nal.usda.gov/api-key-signup
# May also be passed as --key on the command line instead of via env.
FDC_API_KEY=

# --- tools/names-resolve.mjs -----------------------------------------------
# Wikidata's public SPARQL and REST endpoints need no key. Some deployments
# ask for a descriptive User-Agent; set one if you are resolving in bulk.
# https://foundation.wikimedia.org/wiki/Policy:User-Agent_policy
WIKIDATA_USER_AGENT=

# --- not yet implemented ---------------------------------------------------
# Listed so the next agent knows where these belong when the features land.
# None of these are read by any code in the repository today.

# YouTube Data API v3, for the "watch it made" panel (currently a search link).
YOUTUBE_API_KEY=

# Instacart Developer Platform — the only cart-building API the app targets.
INSTACART_API_KEY=

# Kroger Cart API (US only). OAuth client credentials.
KROGER_CLIENT_ID=
KROGER_CLIENT_SECRET=

# Salla / Zid merchant apps (Saudi). Per-merchant OAuth, not per-shopper.
SALLA_CLIENT_ID=
SALLA_CLIENT_SECRET=
ZID_CLIENT_ID=
ZID_CLIENT_SECRET=
